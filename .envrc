use flake

watch_file pyproject.toml
watch_file uv.lock

sync_stamp=.direnv/uv-sync.stamp
mkdir -p .direnv

if [[ ! -d .venv || pyproject.toml -nt "$sync_stamp" || uv.lock -nt "$sync_stamp" ]]; then
  uv sync
  touch "$sync_stamp"
fi

export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"
export UV_ACTIVE=1
